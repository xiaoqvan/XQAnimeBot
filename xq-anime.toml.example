# XQAnimeBot（Rust 版）全局配置段样例
#
# 用法：把下面的 `[plugin.xq.anime]` 段（含所有子段）**原样粘进宿主 `fuyubot.toml`**。
# 插件启动时经 `host.get_config("xq.anime", "")` 读这一整段（JSON），所以字段名
# 必须和下面的 snake_case 完全一致——写错会直接报错（deny_unknown_fields），不会静默忽略。
#
# 环境变量可以覆盖凭据（不写进配置文件）：
#   XQ_MONGO_URI / XQ_MONGO_DB / XQ_QB_HOST / XQ_QB_USERNAME / XQ_QB_PASSWORD /
#   DEEPSEEK_API_KEY（或 OPENAI_API_KEY）
#
# 测试 / 回放仍可走 `plugin_start` 的内联 `config_toml`（优先级最高，见 runtime.rs）。

[plugin.xq.anime.telegram]
# 导航频道：番剧卡发这里
nav_channel = -1000000000000
# 番剧频道：每集视频发这里
anime_channel = -1000000000000
# 缓冲频道/群：拿不准的片子（低置信度新番、集数没对齐）先发这里，确认后才转正片
# 填 0 = 退回管理群的番剧话题（与 TS 的 sendMegToCache 一致）
cache_channel = 0
# 管理群：待审核提示、错误通知
admin_group_id = -1000000000000
# 话题 id（论坛式群组）。0 = 主楼
anime_group_thread_id = 0
nav_group_thread_id = 0
error_group_thread_id = 0
# 主人 user id（预留给权限校验）
owner_id = 0

[plugin.xq.anime.qbittorrent]
host = "http://127.0.0.1:8080"
username = "admin"
password = ""
# 下载落到哪个目录（qB 自己落盘，插件只读）
save_path = "D:/downloads/xq-anime"
# 等下载完成的最长秒数
download_timeout_secs = 21600
# 发送成功后删种 + 删文件（TS 的 cleanupLocalMedia）。想保种就改 false
delete_torrent_after_send = true
poll_interval_secs = 5

[plugin.xq.anime.mongodb]
# 本插件的 [mongodb] 会通过 storage.mongo 的 configure 方法**真正生效**（启动时下发）。
# 本地示例：
uri = "mongodb://127.0.0.1:27017"
# 云端示例（Atlas / 自建 TLS 都行，驱动自己解析 SRV）：
# uri = "mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# 与 TS 版一致：TS 从 MONGODB_URL 取库名，缺省 fuyubot
database = "fuyubot"
# 连接/选择超时（毫秒）。云端抖动时宁可快速失败，默认 10 秒
timeout_ms = 10000

[plugin.xq.anime.rss]
# 0 = 按北京时间自动分时段（21-次日2 点 1 分钟一轮，白天 15 分钟）
# 非 0 = 固定间隔（秒）
interval_secs = 0
# 每个源最多取多少条
max_items = 50
# 下载并发槽位
workers = 3
# MKV 独立槽位（预留给烧字幕队列）
mkv_workers = 1
# 黑名单关键词（标题包含即跳过）
blacklist = []
# 是否用 AI 兜底解析集数（还没接）
ai_episode_fallback = false

[plugin.xq.anime.bangumi]
app_id = ""
app_secret = ""
access_token = ""
# Bangumi 要求带可识别 UA（公开接口目前用通用 UA）
user_agent = "XQAnimeBot/0.1 (https://github.com/xiaoqvan/XQAnimeBot)"

[plugin.xq.anime.media]
# ffmpeg / ffprobe 路径；只写文件名表示走 PATH
ffmpeg = "ffmpeg"
ffprobe = "ffprobe"
# 转码临时目录；空 = 系统临时目录下的 xq-anime
work_dir = ""
# 转码成功后删掉源文件
delete_source_after_remux = true
# 单个视频最长处理秒数
timeout_secs = 7200
# 单条消息能发的最大字节数；超过就按大小分段（TG 约 2GB）
max_upload_bytes = 1950000000

# LLM Agent：番剧/集数匹配（Responses API 工具调用）。关掉就完全走规则
#
# base_url 不要加 /v1：代码会拼成 `{base_url}/responses`。
# DeepSeek 官方就是这个路径；换 OpenRouter 时填 https://openrouter.ai/api/v1。
# model 用官方当前名 `deepseek-flash`（旧名 deepseek-v4-flash 已退役，但仍被接受）。
# api_key 也可不写在这里、改走环境变量 DEEPSEEK_API_KEY / OPENAI_API_KEY
# （仅当本项为空时才用环境变量，配置文件优先）。
[plugin.xq.anime.ai]
enabled = false
api_key = ""
base_url = "https://api.deepseek.com"
model = "deepseek-flash"

[plugin.xq.anime.http]
# 管理 API 监听地址；空 = 不启动（只读接口，无前端）
# 例：127.0.0.1:8787
listen = ""
token = ""
